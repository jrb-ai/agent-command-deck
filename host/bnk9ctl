"""bnk9ctl - report an agent state change to bnk9d.

Called from agent hooks. Must be fast and silent, and swallows all
errors so hooks never disturb the agent.

Sessions launched from the pad carry BNK9_SLOT. Sessions you started
yourself do not, so the slot is resolved from the terminal instead: the
daemon tracks each slot by the tty of its session, and this walks up the
process tree to find the tty of the agent that invoked the hook. That is
what lets a session adopted with a key-hold report state like a spawned
one. Unknown ttys are ignored by the daemon.

Usage:
  bnk9ctl <running|input|waiting|ended>   # Claude Code / Hermes hooks
  bnk9ctl --codex <json>                  # Codex notify program
"""

from __future__ import annotations  # /usr/bin/python3 is 3.9 here

import os
import sys


def detect_tty() -> str | None:
    """Controlling terminal of this process or its nearest ancestor."""
    for fd in (0, 1, 2):
        try:
            return os.ttyname(fd)
        except OSError:
            pass
    # Hooks run detached from the terminal, so inspect the ancestry: the
    # agent process itself still holds the tty.
    import subprocess
    try:
        snapshot = subprocess.run(
            ["ps", "-Ao", "pid=,ppid=,tty="],
            capture_output=True, text=True, timeout=3).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    parent, tty = {}, {}
    for line in snapshot.splitlines():
        parts = line.split()
        if len(parts) == 3:
            pid, ppid, term = parts
            parent[pid] = ppid
            tty[pid] = term
    pid = str(os.getpid())
    for _ in range(12):  # bounded walk; guards against a parent cycle
        term = tty.get(pid)
        if term and term not in ("?", "??", "-"):
            return term if term.startswith("/dev/") else f"/dev/{term}"
        pid = parent.get(pid)
        if pid is None or pid == "0":
            return None
    return None


# Claude Code fires Notification both when it is blocked on a decision
# and when a session has simply been idle for a minute. Only the former
# should read as urgent, so the message text is used to tell them apart.
IDLE_NUDGE = "waiting for your input"


def classify_notification(raw: str) -> str:
    """Report a block as "waiting", an idle reminder as "input"."""
    import json
    try:
        message = str(json.loads(raw).get("message", ""))
    except (ValueError, AttributeError):
        return "waiting"
    return "input" if IDLE_NUDGE in message.lower() else "waiting"


def main() -> None:
    if not sys.argv[1:]:
        return

    if sys.argv[1] == "--codex":
        import json
        try:
            event = json.loads(sys.argv[-1])
        except (ValueError, IndexError):
            return
        if event.get("type") != "agent-turn-complete":
            return
        state = "input"
    else:
        state = sys.argv[1]

    # Drain stdin so the hook runner never sees a broken pipe.
    raw = ""
    if not sys.stdin.isatty():
        try:
            raw = sys.stdin.read()
        except OSError:
            pass

    reminder = False
    if state == "waiting" and raw:
        state = classify_notification(raw)
        # The idle nudge repeats every minute; flag it so a dismissal
        # you have already made is not undone by the next one.
        reminder = state == "input"

    # Send both identifiers. The tty says which terminal this actually
    # is; BNK9_SLOT only says which slot launched it, which goes stale
    # if the slot is later pointed at a different session.
    message = {"state": state, "reminder": reminder}
    slot = os.environ.get("BNK9_SLOT")
    if slot:
        message["slot"] = slot
    tty = detect_tty()
    if tty is not None:
        message["tty"] = tty
    if "slot" not in message and "tty" not in message:
        return

    import json
    import socket
    sock_path = os.path.expanduser("~/.bnk9/bnk9d.sock")
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(0.5)
            sock.connect(sock_path)
            sock.sendall(json.dumps(message).encode())
    except (OSError, ValueError):
        pass


if __name__ == "__main__":
    main()
